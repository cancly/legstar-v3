package legstar.samples.stru01;

import java.math.BigDecimal;
import java.util.Arrays;

import org.legstar.cobol.annotation.*;



@CobolGroup(cobolName = "STRU01-RECORD")

@CobolEncoding(hostCharsetName = "IBM01140", rightPadCobolAlphanumWithSpaces = true, truncateHostStringsTrailingSpaces = false)


public class Stru01Record implements org.legstar.cobol.model.Copybook {


    @CobolOrder(0)



    @CobolZonedDecimal(cobolName = "COM-NUMBER", totalDigits = 6)
    private BigDecimal comNumber;


    @CobolOrder(1)



    @CobolString(cobolName = "COM-NAME", charNum = 20)
    private String comName;


    @CobolOrder(2)



    @CobolPackedDecimal(cobolName = "COM-AMOUNT", totalDigits = 7, fractionDigits = 2)
    private BigDecimal comAmount;


    @CobolOrder(3)



    private ComSubRecord comSubRecord;








    public BigDecimal getComNumber() {
        return comNumber;
    }

    public void setComNumber(BigDecimal comNumber) {
        if (comNumber != null) {
            java.math.BigDecimal maximum = java.math.BigDecimal.TEN.pow(6)
                .subtract(java.math.BigDecimal.ONE).movePointLeft(0);
            if (comNumber.abs().compareTo(maximum) > 0) {
                throw new IllegalArgumentException("comNumber: absolute value exceeds " + maximum);
            }
        }
        this.comNumber = comNumber;
    }






    public String getComName() {
        return comName;
    }

    public void setComName(String comName) {
        if (comName != null && comName.length() > 20) {
            throw new IllegalArgumentException("comName: maximum length is 20");
        }
        this.comName = comName;
    }






    public BigDecimal getComAmount() {
        return comAmount;
    }

    public void setComAmount(BigDecimal comAmount) {
        if (comAmount != null) {
            java.math.BigDecimal maximum = java.math.BigDecimal.TEN.pow(7)
                .subtract(java.math.BigDecimal.ONE).movePointLeft(2);
            if (comAmount.abs().compareTo(maximum) > 0) {
                throw new IllegalArgumentException("comAmount: absolute value exceeds " + maximum);
            }
            if (comAmount.signum() < 0) {
                throw new IllegalArgumentException("comAmount: negative values are not allowed");
            }
        }
        this.comAmount = comAmount;
    }







    public ComSubRecord getComSubRecord() {
        return comSubRecord;
    }

    public void setComSubRecord(ComSubRecord comSubRecord) {
        this.comSubRecord = comSubRecord;
    }












    @CobolGroup(cobolName = "COM-SUB-RECORD")


    public static class ComSubRecord implements org.legstar.cobol.model.Copybook {


        @CobolOrder(0)



        @CobolBinaryNumber(cobolName = "COM-ITEM1", signed = true, totalDigits = 4)
        private Short comItem1;


        @CobolOrder(1)



        @CobolString(cobolName = "COM-ITEM2", charNum = 2)
        private String comItem2;









        public Short getComItem1() {
            return comItem1;
        }

        public void setComItem1(Short comItem1) {
            if (comItem1 != null) {
                java.math.BigDecimal maximum = java.math.BigDecimal.TEN.pow(4)
                    .subtract(java.math.BigDecimal.ONE).movePointLeft(0);
                if (new java.math.BigDecimal(comItem1.toString()).abs().compareTo(maximum) > 0) {
                    throw new IllegalArgumentException("comItem1: absolute value exceeds " + maximum);
                }
            }
            this.comItem1 = comItem1;
        }






        public String getComItem2() {
            return comItem2;
        }

        public void setComItem2(String comItem2) {
            if (comItem2 != null && comItem2.length() > 2) {
                throw new IllegalArgumentException("comItem2: maximum length is 2");
            }
            this.comItem2 = comItem2;
        }











        @Override
        public String toString() {
            StringBuilder sb = new StringBuilder();
            sb.append("{")


                .append("comItem1=").append(comItem1)


                .append(", comItem2=").append(comItem2)

                .append("}");
            return sb.toString();
        }

    }





    @Override
    public String toString() {
        StringBuilder sb = new StringBuilder();
        sb.append("{")


            .append("comNumber=").append(comNumber)


            .append(", comName=").append(comName)


            .append(", comAmount=").append(comAmount)


            .append(", comSubRecord=").append(comSubRecord)

            .append("}");
        return sb.toString();
    }

}
