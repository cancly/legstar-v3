package legstar.samples.rdef03;

import java.math.BigDecimal;
import java.util.Arrays;

import org.legstar.cobol.annotation.*;



@CobolGroup(cobolName = "RDEF03-RECORD")

@CobolEncoding(hostCharsetName = "IBM01140", rightPadCobolAlphanumWithSpaces = true, truncateHostStringsTrailingSpaces = false)


public class Rdef03Record implements org.legstar.cobol.model.Copybook {


    @CobolOrder(0)



    @CobolBinaryNumber(cobolName = "COM-SELECT", totalDigits = 4)
    private Short comSelect;


    @CobolOrder(1)



    private ComDetail1Choice comDetail1Choice;









    public Short getComSelect() {
        return comSelect;
    }

    public void setComSelect(Short comSelect) {
        if (comSelect != null) {
            java.math.BigDecimal maximum = java.math.BigDecimal.TEN.pow(4)
                .subtract(java.math.BigDecimal.ONE).movePointLeft(0);
            if (new java.math.BigDecimal(comSelect.toString()).abs().compareTo(maximum) > 0) {
                throw new IllegalArgumentException("comSelect: absolute value exceeds " + maximum);
            }
            if (new java.math.BigDecimal(comSelect.toString()).signum() < 0) {
                throw new IllegalArgumentException("comSelect: negative values are not allowed");
            }
        }
        this.comSelect = comSelect;
    }







    public ComDetail1Choice getComDetail1Choice() {
        return comDetail1Choice;
    }

    public void setComDetail1Choice(ComDetail1Choice comDetail1Choice) {
        this.comDetail1Choice = comDetail1Choice;
    }








    @CobolChoice(cobolName = "COM-DETAIL1", maxBytesLen = 10)

    public static class ComDetail1Choice {


        @CobolOrder(0)



        private ComDetail1 comDetail1;


        @CobolOrder(1)



        private ComDetail2 comDetail2;


        @CobolOrder(2)



        private ComDetail3 comDetail3;









        public ComDetail1 getComDetail1() {
            return comDetail1;
        }

        public void setComDetail1(ComDetail1 comDetail1) {
            this.comDetail1 = comDetail1;
        }







        public ComDetail2 getComDetail2() {
            return comDetail2;
        }

        public void setComDetail2(ComDetail2 comDetail2) {
            this.comDetail2 = comDetail2;
        }







        public ComDetail3 getComDetail3() {
            return comDetail3;
        }

        public void setComDetail3(ComDetail3 comDetail3) {
            this.comDetail3 = comDetail3;
        }






        @CobolGroup(cobolName = "COM-DETAIL1")


        public static class ComDetail1 implements org.legstar.cobol.model.Copybook {


            @CobolOrder(0)



            @CobolString(cobolName = "COM-NAME", charNum = 10)
            private String comName;








            public String getComName() {
                return comName;
            }

            public void setComName(String comName) {
                if (comName != null && comName.length() > 10) {
                    throw new IllegalArgumentException("comName: maximum length is 10");
                }
                this.comName = comName;
            }









            @Override
            public String toString() {
                StringBuilder sb = new StringBuilder();
                sb.append("{")


                    .append("comName=").append(comName)

                    .append("}");
                return sb.toString();
            }

        }




        @CobolGroup(cobolName = "COM-DETAIL2")


        public static class ComDetail2 implements org.legstar.cobol.model.Copybook {


            @CobolOrder(0)



            @CobolPackedDecimal(cobolName = "COM-AMOUNT", totalDigits = 7, fractionDigits = 2)
            private BigDecimal comAmount;








            public BigDecimal getComAmount() {
                return comAmount;
            }

            public void setComAmount(BigDecimal comAmount) {
                if (comAmount != null) {
                    java.math.BigDecimal maximum = java.math.BigDecimal.TEN.pow(7)
                        .subtract(java.math.BigDecimal.ONE).movePointLeft(2);
                    if (comAmount.abs().compareTo(maximum) > 0) {
                        throw new IllegalArgumentException("comAmount: absolute value exceeds " + maximum);
                    }
                    if (comAmount.signum() < 0) {
                        throw new IllegalArgumentException("comAmount: negative values are not allowed");
                    }
                }
                this.comAmount = comAmount;
            }









            @Override
            public String toString() {
                StringBuilder sb = new StringBuilder();
                sb.append("{")


                    .append("comAmount=").append(comAmount)

                    .append("}");
                return sb.toString();
            }

        }




        @CobolGroup(cobolName = "COM-DETAIL3")


        public static class ComDetail3 implements org.legstar.cobol.model.Copybook {


            @CobolOrder(0)



            @CobolZonedDecimal(cobolName = "COM-NUMBER", totalDigits = 5)
            private BigDecimal comNumber;








            public BigDecimal getComNumber() {
                return comNumber;
            }

            public void setComNumber(BigDecimal comNumber) {
                if (comNumber != null) {
                    java.math.BigDecimal maximum = java.math.BigDecimal.TEN.pow(5)
                        .subtract(java.math.BigDecimal.ONE).movePointLeft(0);
                    if (comNumber.abs().compareTo(maximum) > 0) {
                        throw new IllegalArgumentException("comNumber: absolute value exceeds " + maximum);
                    }
                }
                this.comNumber = comNumber;
            }









            @Override
            public String toString() {
                StringBuilder sb = new StringBuilder();
                sb.append("{")


                    .append("comNumber=").append(comNumber)

                    .append("}");
                return sb.toString();
            }

        }





        @Override
        public String toString() {
            StringBuilder sb = new StringBuilder();
            sb.append("{")


                .append("comDetail1=").append(comDetail1)


                .append(", comDetail2=").append(comDetail2)


                .append(", comDetail3=").append(comDetail3)

                .append("}");
            return sb.toString();
        }

    }





    @Override
    public String toString() {
        StringBuilder sb = new StringBuilder();
        sb.append("{")


            .append("comSelect=").append(comSelect)


            .append(", comDetail1Choice=").append(comDetail1Choice)

            .append("}");
        return sb.toString();
    }

}
