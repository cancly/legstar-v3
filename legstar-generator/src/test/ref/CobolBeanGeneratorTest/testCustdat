package legstar.samples.custdat;

import java.math.BigDecimal;
import java.util.Arrays;
import org.legstar.cobol.model.Copybook;

import org.legstar.cobol.annotation.*;

@CobolGroup(cobolName = "CUSTOMER-DATA")
@CobolEncoding(hostCharsetName = "IBM037", rightPadCobolAlphanumWithSpaces = true, truncateHostStringsTrailingSpaces = false)
public class CustomerData implements Copybook {
    @CobolOrder(0)
    @CobolZonedDecimal(cobolName = "CUSTOMER-ID", totalDigits = 6)
    private BigDecimal customerId;

    @CobolOrder(1)
    private PersonalData personalData;

    @CobolOrder(2)
    private Transactions transactions;

    public BigDecimal getCustomerId() {
        return customerId;
    }

    public void setCustomerId(BigDecimal customerId) {
        if (customerId != null) {
            java.math.BigDecimal maximum = java.math.BigDecimal.TEN.pow(6)
                .subtract(java.math.BigDecimal.ONE).movePointLeft(0);
            if (customerId.abs().compareTo(maximum) > 0) {
                throw new IllegalArgumentException("customerId: absolute value exceeds " + maximum);
            }
        }
        this.customerId = customerId;
    }

    public PersonalData getPersonalData() {
        return personalData;
    }

    public void setPersonalData(PersonalData personalData) {
        this.personalData = personalData;
    }

    public Transactions getTransactions() {
        return transactions;
    }

    public void setTransactions(Transactions transactions) {
        this.transactions = transactions;
    }

    @CobolGroup(cobolName = "PERSONAL-DATA")
    public static class PersonalData implements Copybook {
        @CobolOrder(0)
        @CobolString(cobolName = "CUSTOMER-NAME", charNum = 20)
        private String customerName;

        @CobolOrder(1)
        @CobolString(cobolName = "CUSTOMER-ADDRESS", charNum = 20)
        private String customerAddress;

        @CobolOrder(2)
        @CobolString(cobolName = "CUSTOMER-PHONE", charNum = 8)
        private String customerPhone;

        public String getCustomerName() {
            return customerName;
        }

        public void setCustomerName(String customerName) {
            if (customerName != null && customerName.length() > 20) {
                throw new IllegalArgumentException("customerName: maximum length is 20");
            }
            this.customerName = customerName;
        }

        public String getCustomerAddress() {
            return customerAddress;
        }

        public void setCustomerAddress(String customerAddress) {
            if (customerAddress != null && customerAddress.length() > 20) {
                throw new IllegalArgumentException("customerAddress: maximum length is 20");
            }
            this.customerAddress = customerAddress;
        }

        public String getCustomerPhone() {
            return customerPhone;
        }

        public void setCustomerPhone(String customerPhone) {
            if (customerPhone != null && customerPhone.length() > 8) {
                throw new IllegalArgumentException("customerPhone: maximum length is 8");
            }
            this.customerPhone = customerPhone;
        }

        @Override
        public String toString() {
            StringBuilder sb = new StringBuilder();
            sb.append("{")

                .append("customerName=").append(customerName)

                .append(", customerAddress=").append(customerAddress)

                .append(", customerPhone=").append(customerPhone)

                .append("}");
            return sb.toString();
        }
    }

    @CobolGroup(cobolName = "TRANSACTIONS")
    public static class Transactions implements Copybook {
        @CobolOrder(0)
        @CobolBinaryNumber(cobolName = "TRANSACTION-NBR", totalDigits = 9, odoObject = true)
        private Integer transactionNbr;

        @CobolOrder(1)
        @CobolArray(minOccurs=0, maxOccurs=5, dependingOn = "TRANSACTION-NBR")
        private Transaction[] transaction;

        public Integer getTransactionNbr() {
            return transactionNbr;
        }

        public void setTransactionNbr(Integer transactionNbr) {
            if (transactionNbr != null) {
                java.math.BigDecimal maximum = java.math.BigDecimal.TEN.pow(9)
                    .subtract(java.math.BigDecimal.ONE).movePointLeft(0);
                if (new java.math.BigDecimal(transactionNbr.toString()).abs().compareTo(maximum) > 0) {
                    throw new IllegalArgumentException("transactionNbr: absolute value exceeds " + maximum);
                }
                if (new java.math.BigDecimal(transactionNbr.toString()).signum() < 0) {
                    throw new IllegalArgumentException("transactionNbr: negative values are not allowed");
                }
            }
            this.transactionNbr = transactionNbr;
        }

        public Transaction[] getTransaction() {
            return transaction;
        }

        public void setTransaction(Transaction[] transaction) {
            if (transaction != null) {
                if (transaction.length < 0
                        || transaction.length > 5) {
                    throw new IllegalArgumentException("transaction: expected array length 0..5");
                }
            }
            this.transaction = transaction;
        }

        @CobolGroup(cobolName = "TRANSACTION")
        public static class Transaction implements Copybook {
            @CobolOrder(0)
            private TransactionDateChoice transactionDateChoice;

            @CobolOrder(1)
            @CobolPackedDecimal(cobolName = "TRANSACTION-AMOUNT", signed = true, totalDigits = 15, fractionDigits = 2)
            private BigDecimal transactionAmount;

            @CobolOrder(2)
            @CobolString(cobolName = "TRANSACTION-COMMENT", charNum = 9)
            private String transactionComment;

            public TransactionDateChoice getTransactionDateChoice() {
                return transactionDateChoice;
            }

            public void setTransactionDateChoice(TransactionDateChoice transactionDateChoice) {
                this.transactionDateChoice = transactionDateChoice;
            }

            public BigDecimal getTransactionAmount() {
                return transactionAmount;
            }

            public void setTransactionAmount(BigDecimal transactionAmount) {
                if (transactionAmount != null) {
                    java.math.BigDecimal maximum = java.math.BigDecimal.TEN.pow(15)
                        .subtract(java.math.BigDecimal.ONE).movePointLeft(2);
                    if (transactionAmount.abs().compareTo(maximum) > 0) {
                        throw new IllegalArgumentException("transactionAmount: absolute value exceeds " + maximum);
                    }
                }
                this.transactionAmount = transactionAmount;
            }

            public String getTransactionComment() {
                return transactionComment;
            }

            public void setTransactionComment(String transactionComment) {
                if (transactionComment != null && transactionComment.length() > 9) {
                    throw new IllegalArgumentException("transactionComment: maximum length is 9");
                }
                this.transactionComment = transactionComment;
            }

            @CobolChoice(cobolName = "TRANSACTION-DATE", maxBytesLen = 8)
            public static class TransactionDateChoice {
                @CobolOrder(0)
                @CobolString(cobolName = "TRANSACTION-DATE", charNum = 8)
                private String transactionDate;

                @CobolOrder(1)
                private Filler filler;

                public String getTransactionDate() {
                    return transactionDate;
                }

                public void setTransactionDate(String transactionDate) {
                    if (transactionDate != null && transactionDate.length() > 8) {
                        throw new IllegalArgumentException("transactionDate: maximum length is 8");
                    }
                    this.transactionDate = transactionDate;
                }

                public Filler getFiller() {
                    return filler;
                }

                public void setFiller(Filler filler) {
                    this.filler = filler;
                }

                @CobolGroup(cobolName = "FILLER")
                public static class Filler implements Copybook {
                    @CobolOrder(0)
                    @CobolString(cobolName = "TRANSACTION-DAY", charNum = 2)
                    private String transactionDay;

                    @CobolOrder(1)
                    @CobolString(cobolName = "FILLER", charNum = 1)
                    private String filler;

                    @CobolOrder(2)
                    @CobolString(cobolName = "TRANSACTION-MONTH", charNum = 2)
                    private String transactionMonth;

                    @CobolOrder(3)
                    @CobolString(cobolName = "FILLER", charNum = 1)
                    private String filler_3;

                    @CobolOrder(4)
                    @CobolString(cobolName = "TRANSACTION-YEAR", charNum = 2)
                    private String transactionYear;

                    public String getTransactionDay() {
                        return transactionDay;
                    }

                    public void setTransactionDay(String transactionDay) {
                        if (transactionDay != null && transactionDay.length() > 2) {
                            throw new IllegalArgumentException("transactionDay: maximum length is 2");
                        }
                        this.transactionDay = transactionDay;
                    }

                    public String getFiller() {
                        return filler;
                    }

                    public void setFiller(String filler) {
                        if (filler != null && filler.length() > 1) {
                            throw new IllegalArgumentException("filler: maximum length is 1");
                        }
                        this.filler = filler;
                    }

                    public String getTransactionMonth() {
                        return transactionMonth;
                    }

                    public void setTransactionMonth(String transactionMonth) {
                        if (transactionMonth != null && transactionMonth.length() > 2) {
                            throw new IllegalArgumentException("transactionMonth: maximum length is 2");
                        }
                        this.transactionMonth = transactionMonth;
                    }

                    public String getFiller_3() {
                        return filler_3;
                    }

                    public void setFiller_3(String filler_3) {
                        if (filler_3 != null && filler_3.length() > 1) {
                            throw new IllegalArgumentException("filler_3: maximum length is 1");
                        }
                        this.filler_3 = filler_3;
                    }

                    public String getTransactionYear() {
                        return transactionYear;
                    }

                    public void setTransactionYear(String transactionYear) {
                        if (transactionYear != null && transactionYear.length() > 2) {
                            throw new IllegalArgumentException("transactionYear: maximum length is 2");
                        }
                        this.transactionYear = transactionYear;
                    }

                    @Override
                    public String toString() {
                        StringBuilder sb = new StringBuilder();
                        sb.append("{")

                            .append("transactionDay=").append(transactionDay)

                            .append(", filler=").append(filler)

                            .append(", transactionMonth=").append(transactionMonth)

                            .append(", filler_3=").append(filler_3)

                            .append(", transactionYear=").append(transactionYear)

                            .append("}");
                        return sb.toString();
                    }
                }

                @Override
                public String toString() {
                    StringBuilder sb = new StringBuilder();
                    sb.append("{")

                        .append("transactionDate=").append(transactionDate)

                        .append(", filler=").append(filler)

                        .append("}");
                    return sb.toString();
                }
            }

            @Override
            public String toString() {
                StringBuilder sb = new StringBuilder();
                sb.append("{")

                    .append("transactionDateChoice=").append(transactionDateChoice)

                    .append(", transactionAmount=").append(transactionAmount)

                    .append(", transactionComment=").append(transactionComment)

                    .append("}");
                return sb.toString();
            }
        }

        @Override
        public String toString() {
            StringBuilder sb = new StringBuilder();
            sb.append("{")

                .append("transactionNbr=").append(transactionNbr)

                .append(", transaction=").append(Arrays.toString(transaction))

                .append("}");
            return sb.toString();
        }
    }

    @Override
    public String toString() {
        StringBuilder sb = new StringBuilder();
        sb.append("{")

            .append("customerId=").append(customerId)

            .append(", personalData=").append(personalData)

            .append(", transactions=").append(transactions)

            .append("}");
        return sb.toString();
    }
}
